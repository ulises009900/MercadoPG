{
  "name": "mercadopg",
  "version": "1.0.0",
  "description": "Gestor de Stock con funciones extras - Versión Electron",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:mobile": "esbuild src/mobile/app.jsx --bundle --format=iife --platform=browser --target=es2019 --outfile=src/mobile/app.bundle.js",
    "watch:mobile": "esbuild src/mobile/app.jsx --bundle --format=iife --platform=browser --target=es2019 --outfile=src/mobile/app.bundle.js --watch",
    "mobile:expo:start": "cd mobile-app-expo && npm run start",
    "mobile:tunnel:start": "powershell -NoProfile -ExecutionPolicy Bypass -File start-ngrok-app.ps1",
    "mobile:expo:android": "cd mobile-app-expo && npm run android",
    "mobile:expo:ios": "cd mobile-app-expo && npm run ios",
    "mobile:expo:web": "cd mobile-app-expo && npm run web",
    "desktop:ngrok": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-ngrok-desktop.ps1",
    "cap:sync": "npm run build:mobile && npx cap sync android",
    "apk:debug": "npm run cap:sync ; cd android ; gradlew.bat assembleDebug",
    "rebuild": "electron-builder install-app-deps",
    "dist": "electron-builder",
    "postinstall": "npm run build:mobile && electron-builder install-app-deps",
    "seed": "electron src/seed-database.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@zxing/browser": "^0.1.5",
    "better-sqlite3": "^11.8.1",
    "bonjour-service": "^1.3.0",
    "docx": "^9.5.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "chownr": "^2.0.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.0"
  },
  "build": {
    "appId": "com.mercadopg.app",
    "productName": "MercadoPG",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
